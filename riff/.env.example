# Copy this to .env and fill in real values.
# .env is gitignored; .env.example is checked in.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=...
YTDLP_PATH=E:/Software/riff/riff/yt-dlp/yt-dlp.exe
# Netscape cookies.txt for YouTube auth. Path is whatever you want locally;
# on Render, the value is overridden by render.yaml to /data/yt-cookies.txt
# (path on the persistent disk).
YTDLP_COOKIES_FILE=
PORT=8080
# SOCKS5 proxy list (URL or file path). Pool auto-refreshes every 15 min.
PROXY_LIST_URL=https://raw.githubusercontent.com/proxifly/free-proxy-list/main/proxies/protocols/socks5/data.json
